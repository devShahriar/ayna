{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/bishal/Projects/ayna/.puku-cli/scripts/session-init.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/bishal/Projects/ayna/.puku-cli/scripts/prompt-inject.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/bishal/Projects/ayna/.puku-cli/scripts/pre-tool-gate.sh"
